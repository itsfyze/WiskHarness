{
  "name": "wiskharness",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "main": "desktop/electron-main.cjs",
  "description": "Self-hosted Windows coding assistant with local and cloud Plan models",
  "author": "WiskHarness",
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check agent-ollama.mjs && node --check agent-tools.mjs && node --check goose-runtime.mjs && node --check vibe-runtime.mjs && node --check vibe-ollama.mjs && node --check agent-vibe-mcp.mjs && node --check mcp-manager.mjs && node --check agent-web.mjs && node --check agent-web-mcp.mjs && node --check security-policy.mjs && node --check providers.mjs && node --check git-workspace.mjs && node --check profile-backup.mjs && node --check desktop/electron-main.cjs && node --check public/app.js && node --check public/workbench.js && node --check public/markdown.js && node --check public/performance.js && node --check public/chat-controls.js && node --check obsidian-checkpoint.mjs && node --check plan-chat.mjs",
    "desktop": "electron .",
    "stage:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/stage-runtime.ps1",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build-windows.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build-windows.ps1 -PortableOnly",
    "finish:release": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/finish-release.ps1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@highlightjs/cdn-assets": "11.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dompurify": "3.4.18",
    "express": "^5.1.0",
    "html-to-text": "10.0.1",
    "ipaddr.js": "2.5.0",
    "marked": "18.2.1",
    "semver": "7.8.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.1"
  },
  "build": {
    "appId": "com.localagent.desktop",
    "productName": "WiskHarness",
    "copyright": "WiskHarness",
    "asar": true,
    "directories": {
      "output": "release/v${version}"
    },
    "files": [
      "desktop/electron-main.cjs",
      "package.json",
      "desktop/assets/wiskharness-256.png"
    ],
    "extraResources": [
      {
        "from": "runtime-staging",
        "to": "runtime",
        "filter": [
          "package.json",
          "THIRD-PARTY-NOTICES.md",
          "server.mjs",
          "agent-ollama.mjs",
          "agent-tools.mjs",
          "goose-runtime.mjs",
          "vibe-runtime.mjs",
          "vibe-ollama.mjs",
          "agent-vibe-mcp.mjs",
          "mcp-manager.mjs",
          "agent-web.mjs",
          "agent-web-mcp.mjs",
          "security-policy.mjs",
          "providers.mjs",
          "git-workspace.mjs",
          "profile-backup.mjs",
          "plan-chat.mjs",
          "session-store.mjs",
          "obsidian-checkpoint.mjs",
          "terminal.mjs",
          "updates.mjs",
          "workspace-review.mjs",
          "public/**/*"
        ]
      },
      {
        "from": "runtime-staging/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime-staging/vibe-acp-windows-x86_64-3.1.5.zip",
        "to": "vibe-acp-windows-x86_64-3.1.5.zip"
      },
      {
        "from": "runtime-staging/WiskHarness Update.exe",
        "to": "WiskHarness Update.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/wiskharness.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "WiskHarness Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "WiskHarness Portable ${version}.${ext}"
    },
    "publish": null
  },
  "license": "MIT"
}
